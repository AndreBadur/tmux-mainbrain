# Realm secrets template — copy to `.env.secrets` (gitignored) and fill in.
#   cp .env.secrets.example .env.secrets && chmod 600 .env.secrets
#
# The motor (spawn/resume) sources `.env.secrets` into the kiro-cli child
# environment so the nexus MCP plugins (jira/confluence/opendev/bitbucket),
# which read their tokens via os.environ.get(...), can authenticate WITHOUT the
# tokens living in the committed-candidate `.kiro/mcp.json`.
#
# On a host that also has a global ~/.kiro/settings/mcp.json declaring these
# same servers, that global `env` block takes precedence (empirically verified);
# this file is then the portability fallback for a fresh clone elsewhere.
#
# knowledge needs no secret (WRCP_ENGINE_DIR is a non-secret path in mcp.json).
export JIRA_TOKEN=your-jira-personal-access-token
export CONFLUENCE_TOKEN=your-confluence-personal-access-token
export BITBUCKET_TOKEN=your-bitbucket-http-access-token
# opendev/gerrit: a JSON blob of instances, each with url/user/token/verify_ssl.
export GERRIT_INSTANCES={"internal": {"url": "https://your-gerrit.example.com", "user": "you", "token": "your-gerrit-http-token", "verify_ssl": false}, "opendev": {"url": "https://review.opendev.org", "user": "you", "token": "your-opendev-token", "verify_ssl": true}}
