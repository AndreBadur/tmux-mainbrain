# Per-machine deployment config for journey-tui-web.
#
# Copy this file to  deploy.env  (same folder) and edit the values for THIS
# machine. deploy.env is gitignored — it is machine-specific and must NEVER be
# committed. Each computer uses its OWN tunnel + its OWN hostnames so you reach
# THAT machine's terminal.

# A unique Cloudflare tunnel name for THIS machine (e.g. include the hostname).
JTW_TUNNEL_NAME=journey-tui-web-myhost

# The two PUBLIC hostnames (must be in a zone on your Cloudflare account).
#   _APP  = the web UI ; JTW_PUBLIC_HOST = the embedded terminal (separate origin)
JTW_PUBLIC_HOST_APP=console-myhost.example.com
JTW_PUBLIC_HOST=console-myhost-term.example.com

# A LIVE tmux session on this machine for ttyd to attach to at boot.
JTW_BOOT_SESSION=steward-tui

# Served via the Cloudflare tunnel on standard HTTPS (443): scheme https, no port.
JTW_TTYD_SCHEME=https
JTW_PUBLIC_PORT=
