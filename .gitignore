# --- Python caches ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Backups / editor cruft ---
*.bak
*.swp
*~

# --- Secrets: never version tokens or the MCP config that may hold them ---
.kiro/mcp.json
.env.secrets
*.secrets

# --- Local install overrides (port conflicts, etc.) — never commit ---
.env.install

# --- Operational journey state (ephemeral, per-environment) ---
journeys/*

# --- Palace: keep the folder in git but ignore ALL its contents ---
# (so the structure exists in a fresh environment, but no operational
#  data / curated knowledge / knights-index is versioned)
palace/*
!palace/.gitkeep

# capacitate_from_repo scratch/forge output
.cap-forge/
